{
  "name": "@ramoncoroso/verifactu",
  "version": "1.0.0",
  "description": "TypeScript library for the Spanish AEAT Verifactu invoice reporting system",
  "keywords": [
    "verifactu",
    "aeat",
    "spain",
    "invoice",
    "tax",
    "factura",
    "iva",
    "typescript"
  ],
  "author": "Ramón Coroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramoncoroso/verifactu.git"
  },
  "bugs": {
    "url": "https://github.com/ramoncoroso/verifactu/issues"
  },
  "homepage": "https://github.com/ramoncoroso/verifactu#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:conformance": "vitest run tests/conformance",
    "smoke": "bash scripts/smoke/run.sh",
    "schemas:fetch": "node scripts/fetch-schemas.mjs",
    "schemas:check": "node scripts/fetch-schemas.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:all": "eslint src tests --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jsqr": "^1.4.0",
    "libxml2-wasm": "^0.7.1",
    "semantic-release": "^25.0.8",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
